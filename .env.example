# Database configuration (Local SQLite/LibSQL)
DATABASE_URL="file:../db/custom.db"

# Gemini API Key for AI assistance features
GEMINI_API_KEY="your-gemini-api-key-here"

# Turso Database configuration (Production database)
TURSO_DATABASE_URL="libsql://your-turso-database-url.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token-here"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here-use-openssl-rand-base64-32"

# Razorpay configuration
RAZORPAY_KEY_ID="rzp_test_your_key_id"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ImageKit configuration
IMAGEKIT_PUBLIC_KEY="your-imagekit-public-key"
IMAGEKIT_PRIVATE_KEY="your-imagekit-private-key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_endpoint_id"

# Upstash Redis configuration
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# Upstash QStash configuration
QSTASH_URL="http://127.0.0.1:8080" # or "https://qstash.upstash.io/v2" in production
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-qstash-next-signing-key"

# Brevo configuration (Transactional Emails)
BREVO_API_KEY="your-brevo-api-key"
BREVO_NOREPLY_EMAIL="noreply@lamkacoaching.in"
BREVO_ADMIN_EMAIL="admin@lamkacoaching.in"
BREVO_SENDER_NAME="Lamka Coaching Center"
